# Required for live Stage 1 universe and price filtering.
POLYGON_API_KEY=

# Optional fallback provider for live Stage 2 fundamentals and Stage 3 transcripts.
FMP_API_KEY=

# Starter FMP plans include annual fundamentals/ratios. Set to quarter only if your plan supports it.
FMP_FUNDAMENTAL_PERIOD=annual

# Preferred provider for live Stage 2 quarterly fundamentals and Stage 3 earnings transcripts.
ROIC_API_KEY=

# Optional. Needed later when Stage 3/4 is upgraded from deterministic scoring to LLM review.
ANTHROPIC_API_KEY=
XAI_API_KEY=
XAI_SENTIMENT_MODEL=grok-4.3

# Optional runtime tuning.
PIPELINE_STATE_PATH=pipeline_state.db
MAX_WORKERS=5
SHORTLIST_MIN_SCORE=55
